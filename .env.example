# Variables de entorno de GO Puntos (copiar como .env o .env.local)
# Para ejecutar la maqueta NO hace falta crear ningún archivo .env.
# Nunca subas a GitHub un .env con datos reales (está en .gitignore).

# true  = usa el servidor simulado y los datos de prueba (por defecto)
# false = usa la API REST real indicada en VITE_API_URL
VITE_USE_MOCKS=true

# URL base de la futura API REST (próxima etapa: Express en 127.0.0.1:3000 con el proxy de Vite → /api)
VITE_API_URL=http://localhost:5000/api

# Clave pública VAPID para las notificaciones push (cuando exista el backend)
VITE_VAPID_PUBLIC_KEY=
